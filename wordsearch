def play_puzzle(window):
    global score

    mask = None
    max_word_len = max(nrows, ncols)

    if not wait_for_size(window):
        return 'quit'

    wordlist_filename = puzzlepicker()
    wordlist = sorted(get_wordlist(wordlist_filename), key=lambda w: len(w),
                      reverse=True)

    if max(len(word) for word in wordlist) > max_word_len:
        raise ValueError('Word list contains a word with too many letters.'
                         'The maximum is {}'.format(max(nrows, ncols)))

    allow_backwards_words = False
    grid, solution, placed_words = make_wordsearch(
        nrows, ncols, wordlist, allow_backwards_words, mask)
    if not grid:
        return 'quit'

    remaining = list(wordlist)
    path = []
    found_cells = set()
    category = os.path.splitext(os.path.basename(wordlist_filename))[0]
    row, col = nrows // 2, ncols // 2
    status = None
    hover = None

    def paint():
        draw_all(window, layout, grid, remaining, category, path,
                 found_cells, status, hover)
        place_cursor(window, layout, row, col)
        window.refresh()

    def wait_for_next_game():
        nonlocal layout, row, col
        while True:
            nxt = read_key(window)
            if nxt == curses.KEY_RESIZE:
                if not wait_for_size(window):
                    return 'quit'
                layout, row, col = relayout(window, row, col)
                paint()
                continue
            if nxt in (curses.ERR,):
                continue
            if isinstance(nxt, tuple) and nxt and nxt[0] == 'mouse':
                if nxt[3] == 'press' and nxt[4] == 1:
                    return 'next'
                continue
            if nxt in (ord('q'), ord('Q'), 27):
                return 'quit'
            return 'next'

    def select_cell(at_row, at_col, ignore_duplicate=False):
        """Add a cell to the current path. Returns 'next'/'quit' on a win."""
        global score
        nonlocal path, remaining, found_cells, status, row, col, layout
        row, col = at_row, at_col
        if ignore_duplicate and path and path[-1] == (at_row, at_col):
            return None
        if not path_is_step(path, at_row, at_col):
            curses.beep()
            return None
        path.append((at_row, at_col))
        matched = match_placed(placed_words, remaining, path)
        if matched:
            score += len(matched)
            remaining.remove(matched)
            found_cells.update(path)
            path = []
            if not remaining:
                status = "Congratulations! Press any key for a new game."
                layout, row, col = relayout(window, row, col)
                paint()
                return wait_for_next_game()
        return None

    def handle_mouse(event):
        nonlocal row, col, hover
        _tag, mx, my, kind, button = event
        cell = yx_to_cell(layout, my, mx)
        if cell is not None and kind == 'press' and button == 1:
            hover = cell
            return select_cell(cell[0], cell[1], ignore_duplicate=True)
        if cell != hover:
            hover = cell
            if cell is not None:
                row, col = cell
        return None

    layout, row, col = relayout(window, row, col)
    paint()

    while True:
        key = read_key(window)

        if key in (curses.ERR,):
            continue

        if key in (ord('q'), ord('Q'), 27):
            return 'quit'

        if key == curses.KEY_RESIZE or key == 12:  # Ctrl-L redraw
            if not wait_for_size(window):
                return 'quit'
            layout, row, col = relayout(window, row, col)
            paint()
            continue

        if isinstance(key, tuple) and key and key[0] == 'mouse':
            outcome = handle_mouse(key)
            if outcome:
                return outcome
            paint()
            continue

        if key in (curses.KEY_UP, ord('k'), ord('K')):
            if row > 0:
                row -= 1
            else:
                curses.beep()
        elif key in (curses.KEY_DOWN, ord('j'), ord('J')):
            if row < nrows - 1:
                row += 1
            else:
                curses.beep()
        elif key in (curses.KEY_LEFT, ord('h'), ord('H')):
            if col > 0:
                col -= 1
            else:
                curses.beep()
        elif key in (curses.KEY_RIGHT, ord('l'), ord('L')):
            if col < ncols - 1:
                col += 1
            else:
                curses.beep()
        elif key in (curses.KEY_HOME,):
            row, col = 0, 0
        elif key in (curses.KEY_END,):
            row, col = nrows - 1, ncols - 1
        elif key in (10, 13, getattr(curses, 'KEY_ENTER', 10)):
            path = []
            status = None
            paint()
            continue
        elif key == ord(' '):
            outcome = select_cell(row, col)
            if outcome:
                return outcome
            paint()
            continue
        else:
            place_cursor(window, layout, row, col)
            continue

        place_cursor(window, layout, row, col)
        window.refresh()

def Main(window):
